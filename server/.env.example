# ============================================================
# 笔砚云版 · server 环境变量模板
# 用法：复制为 .env 并填写真实值（.env 已被 git 忽略，禁止提交）
# 参考：TODO-笔砚云版开发执行清单 M1
# ============================================================

# ---- 数据库（与部署环境保持一致，勿本地 9.2 / 部署 8.4 混用）----
DATABASE_URL="mysql://biyan:PASSWORD@localhost:3306/biyan_cloud"
# Prisma migrate dev 的 shadow database（需额外授权）
SHADOW_DATABASE_URL="mysql://biyan:PASSWORD@localhost:3306/biyan_shadow"

# ---- 鉴权 ----
# JWT 签名密钥：生产必须 ≥32 位随机串；refresh token 为随机 opaque 串（DB 存哈希）
JWT_SECRET=your_random_jwt_secret_here
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DAYS=7

# ---- 服务 ----
PORT=3000
# 允许跨域的前端源（逗号分隔；Step3 联调若配 Vite proxy 可留空）
CORS_ORIGINS=http://localhost:5173

# ---- 协同 ticket 有效期（毫秒）----
COLLAB_TICKET_TTL_MS=60000
