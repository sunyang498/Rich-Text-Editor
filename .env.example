# ============================================================
# 笔砚文档 · 前端环境变量模板
# 用法：复制本文件为 .env 并填写真实值（.env 已被 git 忽略，禁止提交）
# 参考：设计审批v2 / TODO-笔砚云版开发执行清单 Phase A
# ============================================================

# ---- 智谱 GLM（AI 流式输出，当前由前端直连）----
# 说明：免费额度但请务必在智谱控制台为此 Key 设置额度上限；
#       Key 一旦泄露（曾硬编码进 git 历史）必须轮换后再填。
VITE_ZHIPU_API_KEY=your_zhipu_api_key_here
VITE_ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ---- 笔砚云版协同/REST 服务地址（M1 起启用）----
# 开发期：前后端分离，建议指向本地 server（见根 package.json dev:server）
# 生产：替换为 https://你的域名/collaboration
# VITE_API_BASE=http://localhost:3000/api/v1
# VITE_COLLAB_URL=http://localhost:3000/collaboration
